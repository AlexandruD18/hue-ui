{
    "name": "hue-ui",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "description": "Random color palettes for interfaces. Every color has a job, every pair is readable.",
    "author": "Alexandru Mihai Dimofte",
    "license": "MIT",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "typecheck": "tsc -b --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "lhci": "lhci autorun"
    },
    "dependencies": {
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@eslint/js": "^10.0.1",
        "@lhci/cli": "^0.16.1",
        "@playwright/test": "^1.65.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.10",
        "@types/culori": "^4.0.1",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "culori": "^4.0.2",
        "eslint": "^10.14.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.14.0",
        "jsdom": "^31.0.0",
        "prettier": "^3.10.1",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.72.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.0",
        "vitest-axe": "^0.1.0"
    },
    "overrides": {
        "basic-ftp": "^6.2.6",
        "@typescript-eslint/typescript-estree": {
            "minimatch": "^11.0.8"
        }
    }
}
